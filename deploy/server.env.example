# Copy to /opt/petroad/secrets/server.env with mode 0600; generate secrets on the server.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
SWAGGER_ENABLED=true
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_ACCOUNT_MAX_FAILURES=50
LOGIN_ACCOUNT_FAILURE_WINDOW=1h
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_WINDOW=1m
